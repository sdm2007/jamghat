const i18n = {
  en:{tagline:'Know price. Know stock. Buy nearby.',search:"Search products, services, or local shops…",nearby:'Nearby local businesses',open:'Open now',closed:'Closed',login:'Business login',register:'List your shop',catalog:'Catalog & pricing',hours:'Opening hours',dashboard:'Business dashboard'},
  hi:{tagline:'दुकान पास, भाव साफ़, सामान पक्का।',search:'सामान, सेवा या स्थानीय दुकान खोजें…',nearby:'आपके आस-पास की दुकानें',open:'अभी खुला',closed:'बंद',login:'दुकानदार लॉग इन',register:'अपनी दुकान जोड़ें',catalog:'कैटलॉग और भाव',hours:'खुलने का समय',dashboard:'दुकानदार डैशबोर्ड'}
};
const distText=b=>{const d=Number(b?.distance);return Number.isFinite(d)&&d<900?`${d} km`:''};
function App(){
  const [theme,setTheme]=useState(localStorage.getItem('mh-theme')||'system');
  const [lang,setLang]=useState(localStorage.getItem('mh-lang')||'en');
  const [user,setUser]=useState(null);
  const [page,setPage]=useState('home'); const [query,setQuery]=useState(''); const [category,setCategory]=useState('ALL');
  const [businesses,setBusinesses]=useState([]); const [selected,setSelected]=useState(null); const [loading,setLoading]=useState(true); const [error,setError]=useState('');
  const [authMode,setAuthMode]=useState(null);
  const [notice,setNotice]=useState('');
  const [customerLocation,setCustomerLocation]=useState(()=>{try{return JSON.parse(localStorage.getItem('mh-location'))||DEFAULT_LOCATION}catch{return DEFAULT_LOCATION}});
  const [locating,setLocating]=useState(false); const [locationMessage,setLocationMessage]=useState('');
  const t=i18n[lang];
  useEffect(()=>{document.documentElement.dataset.theme=theme;localStorage.setItem('mh-theme',theme)},[theme]);
  useEffect(()=>{localStorage.setItem('mh-lang',lang)},[lang]);
  useEffect(()=>{api('/auth/me').then(x=>{setUser(x.user);setPage(x.user.role==='ADMIN'?'admin':'dashboard')}).catch(()=>{})},[]);
  useEffect(()=>{const params=new URLSearchParams(window.location.search);const verificationToken=params.get('verify_email');if(!verificationToken)return;api(`/auth/verify-email?token=${encodeURIComponent(verificationToken)}`).then(x=>setNotice(x.message||'Email verified. You can now sign in.')).catch(e=>setNotice(e.message)).finally(()=>{params.delete('verify_email');const qs=params.toString();window.history.replaceState({},'',`${window.location.pathname}${qs?`?${qs}`:''}${window.location.hash}`)});},[]);
  useEffect(()=>{loadBusinesses()},[query,category,customerLocation?.lat,customerLocation?.lng]);
  async function api(path,opts={}){const headers={'Content-Type':'application/json',...(opts.headers||{})};const r=await fetch(`${API_BASE}${path}`,{...opts,headers,credentials:'include'});const data=await r.json().catch(()=>({}));if(!r.ok){const err=new Error(data.error||'Request failed');err.code=data.code;throw err}return data}
  async function loadBusinesses(){setLoading(true);setError('');try{setBusinesses(await api(`/businesses?q=${encodeURIComponent(query)}&category=${encodeURIComponent(category==='ALL'?'':category)}&lat=${encodeURIComponent(customerLocation?.lat||'')}&lng=${encodeURIComponent(customerLocation?.lng||'')}`))}catch(e){setError(e.message)}finally{setLoading(false)}}
  function chooseCustomerLocation(next){setCustomerLocation(next);localStorage.setItem('mh-location',JSON.stringify(next))}
  async function useMyLocation(){setLocationMessage('');if(!navigator.geolocation){setLocationMessage('Location is not supported by this browser.');return}setLocating(true);navigator.geolocation.getCurrentPosition(pos=>{const next={lat:Number(pos.coords.latitude.toFixed(6)),lng:Number(pos.coords.longitude.toFixed(6)),label:'Your current location'};chooseCustomerLocation(next);setLocationMessage('Using your current location.');setLocating(false)},err=>{setLocationMessage(err.code===1?'Location permission was denied. You can still browse nearby businesses.':'Unable to get your location. Try again or use the default area.');setLocating(false)},{enableHighAccuracy:true,timeout:10000,maximumAge:300000})}
  async function login(email,password){const d=await api('/auth/login',{method:'POST',body:JSON.stringify({email,password})});setUser(d.user);setAuthMode(null);setPage(d.user.role==='ADMIN'?'admin':'dashboard')}
  async function logout(){try{await api('/auth/logout',{method:'POST'})}catch{}setUser(null);setPage('home')}
  async function openBusiness(b){try{setSelected(await api(`/businesses/${b.id}`));setPage('business')}catch(e){setError(e.message)}}
  const homeOfUser=user?(user.role==='ADMIN'?'admin':'dashboard'):null;
