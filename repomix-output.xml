    {authMode&&<AuthModal initialMode={authMode} onClose={()=>setAuthMode(null)} onLogin={login} onResend={async(email)=>api('/auth/resend-verification',{method:'POST',body:JSON.stringify({email})})} onRegister={async(d)=>{const result=await api('/business/register',{method:'POST',body:JSON.stringify(d)});setAuthMode(null);setNotice(result.message||'Check your email to verify your account before signing in.')}}/>}
  </div>
}
function NavButton({icon,label,active,onClick}){return <button className={active?'nav-btn active':'nav-btn'} onClick={onClick}>{React.cloneElement(icon,{size:20})}<span>{label}</span></button>}
function ThemeButton({theme,setTheme}){return <button className="icon-btn" title="Theme" onClick={()=>setTheme(theme==='light'?'dark':theme==='dark'?'system':'light')}>{theme==='dark'?<Moon size={17}/>:theme==='light'?<Sun size={17}/>:<Monitor size={17}/>}</button>}
function Home({query,setQuery,category,setCategory,businesses,loading,openBusiness,t,customerLocation,locating,useMyLocation,locationMessage,setCustomerLocation,onRegister,showRegister}){return <div className="stack">
  <section className="hero"><div><span className="eyebrow">LOCAL DISCOVERY</span><h1>Find what you need,<br/><span>nearby.</span></h1><p>Compare local prices, availability and opening hours before you go.</p>{showRegister&&<button type="button" className="hero-cta" onClick={onRegister}><Store size={16}/> {t.register}</button>}</div><div className="hero-orb">⌁</div></section>
  <div className="search-wrap"><Search size={19}/><input id="market-search" value={query} onChange={e=>setQuery(e.target.value)} placeholder={t.search}/>{query&&<button onClick={()=>setQuery('')}><X size={17}/></button>}</div>
  <LocationBar location={customerLocation} locating={locating} onLocate={useMyLocation} message={locationMessage}/>
  <GoogleMapView businesses={businesses} customerLocation={customerLocation} homeServices={category==='Home Services'} openBusiness={openBusiness} onLocationChange={setCustomerLocation}/>
  <div className="chips">{categories.map(([id,label,icon])=><button key={id} className={category===id?'chip active':'chip'} onClick={()=>setCategory(id)}><span>{icon}</span>{label}</button>)}</div>
  {category==='Home Services'&&!query&&<HomeServiceRadar businesses={businesses} openBusiness={openBusiness}/>}
  <section><div className="section-head"><div><h2>{t.nearby}</h2><small>{businesses.length} local options</small></div><SlidersHorizontal size={18}/></div>
  {loading?<Loading/>:businesses.length===0?<Empty text="We couldn't find this nearby. Try another search or expand your area."/>:<div className="business-grid">{businesses.map(b=><BusinessCard key={b.id} b={b} openBusiness={openBusiness} t={t}/>)}</div>}</section>
  {query.trim()&&<ProductSearchListings query={query} businesses={businesses} openBusiness={openBusiness}/>}
</div>}
function LocationBar({location,locating,onLocate,message}){return <section className="location-bar panel"><div className="location-main"><div className="location-icon"><Navigation size={18}/></div><div><span className="eyebrow">YOUR LOCATION</span><b>{location?.label||'Choose your location'}</b><small>{location?.lat&&location?.lng?`${Number(location.lat).toFixed(5)}, ${Number(location.lng).toFixed(5)}`:'Location not set'}</small></div></div><div className="location-actions"><button className="secondary small" onClick={onLocate} disabled={locating}>{locating?<RefreshCw size={15} className="spin"/>:<LocateFixed size={15}/>} {locating?'Locating…':'Use my location'}</button><a className="icon-btn" href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${location?.lat||DEFAULT_LOCATION.lat},${location?.lng||DEFAULT_LOCATION.lng}`)}`} target="_blank" rel="noreferrer" title="Open location in Google Maps"><ExternalLink size={15}/></a></div>{message&&<small className="location-message">{message}</small>}</section>}
function GoogleMapView({businesses,customerLocation,homeServices,openBusiness,onLocationChange}){const [expanded,setExpanded]=useState(false);const ref=useRef(null);const mapRef=useRef(null);const markersRef=useRef([]);const circlesRef=useRef([]);const infoRef=useRef(null);const [ready,setReady]=useState(false);const [mapError,setMapError]=useState('');
  useEffect(()=>{let cancelled=false;if(!GOOGLE_MAPS_API_KEY){setMapError('Add VITE_GOOGLE_MAPS_API_KEY to frontend/.env to enable the live Google Map. The location and service coverage data still work without the key.');return}if(window.google?.maps){setReady(true);return}const existing=document.getElementById('google-maps-script');if(existing){existing.addEventListener('load',()=>!cancelled&&setReady(true));existing.addEventListener('error',()=>!cancelled&&setMapError('Google Maps could not be loaded. Check your API key and Maps JavaScript API access.'));return ()=>{cancelled=true}}const script=document.createElement('script');script.id='google-maps-script';script.src=`https://maps.googleapis.com/maps/api/js?key=${encodeURIComponent(GOOGLE_MAPS_API_KEY)}&v=weekly`;script.async=true;script.defer=true;script.onload=()=>!cancelled&&setReady(true);script.onerror=()=>!cancelled&&setMapError('Google Maps could not be loaded. Check your API key and Maps JavaScript API access.');document.head.appendChild(script);return()=>{cancelled=true}},[]);
  useEffect(()=>{if(!expanded){mapRef.current=null;markersRef.current.forEach(m=>m.setMap(null));circlesRef.current.forEach(c=>c.setMap(null));markersRef.current=[];circlesRef.current=[];if(infoRef.current)infoRef.current.close();return}if(!ready||!ref.current||!window.google?.maps)return;const center={lat:Number(customerLocation?.lat||DEFAULT_LOCATION.lat),lng:Number(customerLocation?.lng||DEFAULT_LOCATION.lng)};if(!mapRef.current){mapRef.current=new window.google.maps.Map(ref.current,{center,zoom:13,mapTypeControl:false,streetViewControl:false,fullscreenControl:true,gestureHandling:'greedy'});mapRef.current.addListener('click',e=>{if(e.latLng&&onLocationChange)onLocationChange({lat:Number(e.latLng.lat().toFixed(6)),lng:Number(e.latLng.lng().toFixed(6)),label:'Pinned map location'});});}else mapRef.current.setCenter(center);markersRef.current.forEach(m=>m.setMap(null));circlesRef.current.forEach(c=>c.setMap(null));markersRef.current=[];circlesRef.current=[];if(infoRef.current)infoRef.current.close();const customerMarker=new window.google.maps.Marker({map:mapRef.current,position:center,title:'Your location',label:{text:'You',color:'#ffffff',fontWeight:'800'},icon:{path:window.google.maps.SymbolPath.CIRCLE,scale:9,fillColor:'#e65f20',fillOpacity:1,strokeColor:'#ffffff',strokeWeight:2}});markersRef.current.push(customerMarker);const bounds=new window.google.maps.LatLngBounds();bounds.extend(center);const list=businesses.filter(b=>b.latitude!=null&&b.longitude!=null);list.forEach(b=>{const pos={lat:Number(b.latitude),lng:Number(b.longitude)};const marker=new window.google.maps.Marker({map:mapRef.current,position:pos,title:b.name,label:{text:b.name.slice(0,1),color:'#ffffff',fontWeight:'800'}});marker.addListener('click',()=>{if(infoRef.current)infoRef.current.close();infoRef.current=new window.google.maps.InfoWindow({content:`<div style="min-width:210px;font-family:Arial,sans-serif"><strong>${escapeHtml(b.name)}</strong><div style="margin-top:5px;color:#666">${escapeHtml(b.category)} · ${escapeHtml(String(b.distance||'—'))} km away</div>${b.home_visit?`<div style="margin-top:5px">Serves: ${escapeHtml(b.service_area||'Area not specified')}</div><div>Coverage: up to ${escapeHtml(String(b.max_service_radius||'—'))} km</div><div>Visit charge: ₹${Number(b.visit_charge||0).toLocaleString('en-IN')}</div>`:''}<button id="map-open-${b.id}" style="margin-top:8px;padding:6px 9px;border:0;border-radius:7px;background:#e65f20;color:#fff;font-weight:700;cursor:pointer">View details</button></div>`});infoRef.current.open({map:mapRef.current,anchor:marker});window.setTimeout(()=>document.getElementById(`map-open-${b.id}`)?.addEventListener('click',()=>openBusiness(b)),0)});markersRef.current.push(marker);bounds.extend(pos);if(homeServices&&b.home_visit&&Number(b.max_service_radius)>0){const circle=new window.google.maps.Circle({map:mapRef.current,center:pos,radius:Number(b.max_service_radius)*1000,fillColor:'#e65f20',fillOpacity:.08,strokeColor:'#e65f20',strokeOpacity:.28,strokeWeight:1});circlesRef.current.push(circle);}});if(list.length>0)mapRef.current.fitBounds(bounds,{top:40,right:40,bottom:40,left:40});},[ready,expanded,businesses,customerLocation?.lat,customerLocation?.lng,homeServices,openBusiness]);
  return <section className={`map-panel panel map-collapsible ${expanded?'expanded':''}`}><button type="button" className="map-collapse-trigger" onClick={()=>setExpanded(v=>!v)} aria-expanded={expanded}><span className="map-collapse-icon"><MapPin size={22}/></span><span className="map-collapse-copy"><span className="eyebrow">{expanded?'LIVE LOCATION MAP':'EXPLORE ON MAP'}</span><b>{homeServices?'Who serves this area?':'What is nearby?'}</b><small>{expanded?'Tap to hide the map. Click the map to set a location.':'Tap to explore nearby shops and services'}</small></span><span className="map-collapse-chevron">{expanded?'−':'+'}</span></button>{expanded&&(!GOOGLE_MAPS_API_KEY?<div className="map-fallback"><MapPin size={24}/><div><b>Live location map ready</b><p>{mapError||'Google Maps API key is not configured.'}</p><small>Set <code>VITE_GOOGLE_MAPS_API_KEY</code> in <code>frontend/.env</code>, then restart Vite. The map will show your location, nearby businesses and service coverage circles.</small></div></div>:mapError?<div className="error-banner">{mapError}</div>:<div ref={ref} className="google-map" aria-label="Google map showing your location and nearby businesses"/> )}</section>}
function escapeHtml(value){return String(value??'').replace(/[&<>'"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]))}
function HomeServiceRadar({businesses,openBusiness}){
  const providers=businesses.filter(b=>b.home_visit).slice(0,10);
  const angleFor=(index)=>-90+(index*360/Math.max(providers.length,1));
  return <section className="service-radar panel">
    <div className="section-head"><div><span className="eyebrow">HOME SERVICE RADAR</span><h2>Who can come to your area?</h2><small>Coverage, live availability, visit charge and contact details</small></div><span className="radar-live"><span/> LIVE</span></div>
    <div className="radar-layout">
      <div className="radar-map" aria-label="Home service coverage radar">
        <div className="radar-ring ring-1"/><div className="radar-ring ring-2"/><div className="radar-ring ring-3"/><div className="radar-sweep"/>
        <div className="radar-center"><MapPin size={18}/><b>Your area</b><small>Nearby</small></div>
        {providers.map((b,i)=>{const angle=angleFor(i);const coverage=Math.min(43,Math.max(18,Number(b.distance||1)/(Number(b.max_service_radius||10)||10)*43));return <button key={b.id} className="radar-dot-wrap" style={{transform:`rotate(${angle}deg) translateY(-${coverage}%)`}} onClick={()=>openBusiness(b)} title={`${b.name}${distText(b)?` · ${distText(b)} away`:''}`} aria-label={`Open ${b.name}`}><span className="radar-dot"/><span className="radar-label" style={{transform:`rotate(${-angle}deg)`}}>{b.category.replace('Home Services','')}</span></button>})}
      </div>
      <div className="service-provider-list">{providers.map(b=><article className="service-provider" key={b.id} onClick={()=>openBusiness(b)} tabIndex={0} onKeyDown={e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();openBusiness(b)}}}>
        <div className="service-provider-top"><div className="biz-avatar">{b.name.slice(0,1)}</div><div className="biz-main"><div className="biz-title"><h3>{b.name}</h3>{b.verified?<ShieldCheck size={14}/>:null}</div><p>{distText(b)?`${distText(b)} away · `:''}up to {b.max_service_radius||'—'} km coverage</p></div></div>
        <div className="service-meta"><span><MapPin size={13}/>{b.service_area||'Area not specified'}</span><span><Clock3 size={13}/>{b.status_label}</span><span><Phone size={13}/><a href={`tel:${b.phone}`} onClick={e=>e.stopPropagation()}>{b.phone}</a></span><strong>Visit ₹{Number(b.visit_charge||0).toLocaleString('en-IN')}</strong></div>
        <div className="service-tags"><span>{b.is_open?'Available now':'Currently closed'}</span>{b.emergency_service?<span>Emergency</span>:null}{b.appointment_required?<span>Appointment</span>:null}</div>
        <button type="button" className="details-btn" onClick={e=>{e.stopPropagation();openBusiness(b)}}>View service details <ChevronRight size={15}/></button>
      </article>)}</div>
    </div>
  </section>
}
function haversineKmClient(a,b){if(!a||!b||!Number.isFinite(Number(a.lat))||!Number.isFinite(Number(a.lng))||!Number.isFinite(Number(b.lat))||!Number.isFinite(Number(b.lng)))return null;const R=6371,rad=Math.PI/180;const dLat=(Number(b.lat)-Number(a.lat))*rad,dLng=(Number(b.lng)-Number(a.lng))*rad;const x=Math.sin(dLat/2)**2+Math.cos(Number(a.lat)*rad)*Math.cos(Number(b.lat)*rad)*Math.sin(dLng/2)**2;return R*2*Math.atan2(Math.sqrt(x),Math.sqrt(1-x))}
function ServiceCoverageMap({business,customerLocation,onLocationChange}){const ref=useRef(null);const mapRef=useRef(null);const customerMarkerRef=useRef(null);const businessMarkerRef=useRef(null);const circleRef=useRef(null);const [ready,setReady]=useState(false);const [mapError,setMapError]=useState('');const provider={lat:Number(business.latitude),lng:Number(business.longitude)};const customer={lat:Number(customerLocation?.lat),lng:Number(customerLocation?.lng)};const distance=haversineKmClient(provider,customer);const radius=Math.max(0,Number(business.max_service_radius)||0);const inCoverage=distance!=null&&radius>0&&distance<=radius;
  useEffect(()=>{let cancelled=false;if(!GOOGLE_MAPS_API_KEY){setMapError('Add VITE_GOOGLE_MAPS_API_KEY to frontend/.env to enable the live coverage map.');return}if(window.google?.maps){setReady(true);return}const existing=document.getElementById('google-maps-script');if(existing){const onLoad=()=>!cancelled&&setReady(true);const onError=()=>!cancelled&&setMapError('Google Maps could not be loaded. Check your API key and Maps JavaScript API access.');existing.addEventListener('load',onLoad);existing.addEventListener('error',onError);return()=>{cancelled=true;existing.removeEventListener('load',onLoad);existing.removeEventListener('error',onError)}}const script=document.createElement('script');script.id='google-maps-script';script.src=`https://maps.googleapis.com/maps/api/js?key=${encodeURIComponent(GOOGLE_MAPS_API_KEY)}&v=weekly`;script.async=true;script.defer=true;script.onload=()=>!cancelled&&setReady(true);script.onerror=()=>!cancelled&&setMapError('Google Maps could not be loaded. Check your API key and Maps JavaScript API access.');document.head.appendChild(script);return()=>{cancelled=true}},[]);
  useEffect(()=>{if(!ready||!ref.current||!window.google?.maps||!Number.isFinite(provider.lat)||!Number.isFinite(provider.lng))return;const center=Number.isFinite(customer.lat)&&Number.isFinite(customer.lng)?customer:provider;if(!mapRef.current){mapRef.current=new window.google.maps.Map(ref.current,{center,zoom:12,mapTypeControl:false,streetViewControl:false,fullscreenControl:true,gestureHandling:'greedy'});mapRef.current.addListener('click',e=>{if(e.latLng&&onLocationChange)onLocationChange({lat:Number(e.latLng.lat().toFixed(6)),lng:Number(e.latLng.lng().toFixed(6)),label:'Pinned map location'});});}else mapRef.current.setCenter(center);if(customerMarkerRef.current)customerMarkerRef.current.setMap(null);if(businessMarkerRef.current)businessMarkerRef.current.setMap(null);if(circleRef.current)circleRef.current.setMap(null);businessMarkerRef.current=new window.google.maps.Marker({map:mapRef.current,position:provider,title:`${business.name} — service provider`,label:{text:'E',color:'#fff',fontWeight:'800'},icon:{path:window.google.maps.SymbolPath.CIRCLE,scale:10,fillColor:'#e65f20',fillOpacity:1,strokeColor:'#fff',strokeWeight:2}});customerMarkerRef.current=new window.google.maps.Marker({map:mapRef.current,position:customer,title:'Your location',label:{text:'You',color:'#fff',fontWeight:'800'},icon:{path:window.google.maps.SymbolPath.CIRCLE,scale:9,fillColor:inCoverage?'#168b5b':'#c43b35',fillOpacity:1,strokeColor:'#fff',strokeWeight:2}});if(radius>0){circleRef.current=new window.google.maps.Circle({map:mapRef.current,center:provider,radius:radius*1000,fillColor:'#e65f20',fillOpacity:.10,strokeColor:'#e65f20',strokeOpacity:.5,strokeWeight:2,clickable:false});}const bounds=new window.google.maps.LatLngBounds();bounds.extend(provider);if(Number.isFinite(customer.lat)&&Number.isFinite(customer.lng))bounds.extend(customer);if(radius>0&&window.google.maps.geometry?.spherical){const circleBounds=new window.google.maps.LatLngBounds();const earthRadius=6371000;for(let i=0;i<360;i+=45){const angle=i*Math.PI/180;const dLat=(radius*1000/earthRadius)*Math.cos(angle);const dLng=(radius*1000/earthRadius)*Math.sin(angle)/Math.cos(provider.lat*Math.PI/180);circleBounds.extend({lat:provider.lat+dLat*180/Math.PI,lng:provider.lng+dLng*180/Math.PI});}bounds.union(circleBounds);}mapRef.current.fitBounds(bounds,{top:48,right:48,bottom:48,left:48});},[ready,business.id,business.name,business.latitude,business.longitude,business.max_service_radius,customerLocation?.lat,customerLocation?.lng,inCoverage,onLocationChange]);
  if(!GOOGLE_MAPS_API_KEY)return <section className="service-coverage-map panel"><div className="map-fallback"><MapPin size={24}/><div><b>Service coverage map ready</b><p>{mapError}</p><small>Set the key in <code>frontend/.env</code> and restart Vite. The profile will then show the provider’s coverage area and your location together.</small></div></div></section>;
  return <section className="service-coverage-map panel"><div className="section-head"><div><span className="eyebrow">SERVICE COVERAGE MAP</span><h2>{business.name} coverage area</h2><small>The orange circle is the maximum service radius. Click the map to test another customer location.</small></div><MapPin size={18}/></div>{mapError?<div className="error-banner">{mapError}</div>:<div ref={ref} className="google-map service-coverage-google-map" aria-label={`Map showing ${business.name} service coverage and your location`}/>}<div className={distance==null?'coverage-result unknown':inCoverage?'coverage-result inside':'coverage-result outside'}><span className="coverage-dot"/><div><b>{distance==null?'Customer location not set':inCoverage?'You are inside this service area':'You are outside this service area'}</b><small>{distance==null?'Use your location button or click the map to set a location.':`You are ${distance.toFixed(1)} km from the provider · coverage is up to ${radius} km.`}</small></div></div><div className="coverage-legend"><span><i className="legend-provider"/> Provider</span><span><i className={inCoverage?'legend-user-in':'legend-user-out'}/> Your location</span><span><i className="legend-area"/> Service area</span></div></section>}
function BusinessCard({b,openBusiness,t}){const go=()=>openBusiness(b);return <article className="business-card" onClick={go} onKeyDown={e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();go()}}} tabIndex={0} role="button" aria-label={`View details for ${b.name}`}><div className="card-top"><div className="biz-avatar">{b.name.slice(0,1)}</div><div className="biz-main"><div className="biz-title"><h3>{b.name}</h3>{b.verified?<ShieldCheck size={15}/>:null}</div><p>{b.category}{distText(b)?` · ${distText(b)}`:''}</p></div></div><div className="status-row"><span className={b.is_open?'status open':'status closed'}>{b.is_open?'● '+t.open:'● '+t.closed}</span><span>{b.status_label}</span></div><div className="mini-items">{b.items?.slice(0,2).map(i=><div key={i.id}><span>{i.name}</span><b>{priceText(i)}</b><small className="market-price-range">{marketPriceText(i)}</small><em className={`stock ${i.status.toLowerCase()}`}>{!i.availability_verified?'Unverified':i.quantity>0&&i.quantity<5?`Only ${i.quantity} left`:i.status==='IN_STOCK'?'In stock':i.status==='MEDIUM_STOCK'?'Medium stock':i.status==='LOW_STOCK'?'Low stock':'Out of stock'}</em></div>)}</div><div className="card-foot"><span><Package size={14}/> {b.items?.length||0} listed</span><button type="button" className="details-btn" onClick={e=>{e.stopPropagation();go()}} aria-label={`View details for ${b.name}`}>View details <ChevronRight size={15}/></button></div></article>}
function Business({business,onBack,t,customerLocation,setCustomerLocation}){
return <div className="stack">
  <button className="back" onClick={onBack}><ArrowLeft size={17}/> Back to discovery</button><section className="profile-hero"><div className="profile-avatar">{business.name.slice(0,1)}</div><div className="profile-copy"><div className="biz-title"><h1>{business.name}</h1>{business.verified?<ShieldCheck size={18}/>:null}</div><p>{business.category}{distText(business)?` · ${distText(business)} away`:''}</p><div className={business.is_open?'status open':'status closed'}>{business.status_label}</div></div></section>
