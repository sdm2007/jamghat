/* Global interaction layer: every actionable control has hover, focus and pressed feedback. */
button:not(:disabled), a[href], .tab, .chip, .list-card, .metric, .info-grid>div, .catalog-row, .inventory-row, .hour-editor, .admin-row {
  -webkit-tap-highlight-color: transparent;
}
button:not(:disabled), a[href] { transition: transform .16s ease, background-color .16s ease, color .16s ease, border-color .16s ease, box-shadow .16s ease, opacity .16s ease; }
button:not(:disabled):hover, a[href]:hover { text-decoration: none; }
button:not(:disabled):active { transform: translateY(1px) scale(.985); }
button:not(:disabled):focus-visible, a[href]:focus-visible { outline: 3px solid color-mix(in srgb,var(--brand) 42%,transparent); outline-offset: 2px; }
.brand:hover { opacity:.9; transform:translateY(-1px); }
.icon-btn:hover, .avatar:hover { background:var(--surface2); border-color:color-mix(in srgb,var(--brand) 42%,var(--border)); color:var(--brand); transform:translateY(-1px); }
.back:hover { color:var(--brand); transform:translateX(-2px); }
.link-btn:hover { background:var(--surface2); border-radius:8px; }
.tab:hover { color:var(--brand); background:var(--surface2); }
.tab.active { box-shadow:inset 0 -2px 0 var(--brand); }
.chip:hover { border-color:color-mix(in srgb,var(--brand) 45%,var(--border)); color:var(--brand); transform:translateY(-1px); }
.danger-btn:hover { filter:brightness(1.12); transform:translateY(-1px); }
.danger-outline:hover { background:color-mix(in srgb,var(--red) 8%,var(--surface)); border-color:var(--red); }
.info-grid>div { transition:transform .16s ease,border-color .16s ease,background .16s ease,box-shadow .16s ease; }
.info-grid>div:hover { transform:translateY(-2px); border-color:color-mix(in srgb,var(--brand) 35%,var(--border)); background:var(--surface2); box-shadow:var(--shadow); }
.catalog-row, .inventory-row, .hour-editor, .admin-row { transition:background .16s ease,border-color .16s ease,transform .16s ease,box-shadow .16s ease; }
.catalog-row:hover, .inventory-row:hover, .hour-editor:hover, .admin-row:hover { background:var(--surface2); }
.metric { transition:transform .16s ease,border-color .16s ease,box-shadow .16s ease,background .16s ease; }
.metric:hover { transform:translateY(-2px); border-color:color-mix(in srgb,var(--brand) 30%,var(--border)); box-shadow:var(--shadow); background:var(--surface2); }
.photo-remove:hover { transform:scale(1.08); background:var(--red); }
.demo-buttons button:hover { border-color:color-mix(in srgb,var(--brand) 45%,var(--border)); color:var(--brand); background:var(--surface2); transform:translateY(-1px); }
