  {business.photos?.length?<PhotoGallery photos={business.photos} name={business.name}/>:null}
  {business.description&&<section className="panel"><h2>About</h2><p>{business.description}</p>{business.home_visit?<div className="tags"><span>Home visit</span>{business.emergency_service?<span>Emergency service</span>:null}{business.appointment_required?<span>Appointment required</span>:null}</div>:null}</section>}
  <section className="panel"><div className="section-head"><h2>{t.catalog}</h2><small>Freshness matters</small></div><div className="catalog">{business.items?.map(i=><div className="catalog-row" key={i.id}><div><b>{i.name}</b><small>{i.type==='SERVICE'?'Service':'Product'} · {i.availability_verified?'Updated '+relative(i.updated_at):'Availability may be outdated'}</small>{i.description&&<p>{i.description}</p>}</div><div className="catalog-right"><div className="catalog-price-wrap"><strong>{priceText(i)}</strong><small className="market-price-range">{marketPriceText(i)}</small><span className={`stock ${i.status.toLowerCase()}`}>{!i.availability_verified?'Availability unverified':i.quantity>0&&i.quantity<5?`Only ${i.quantity} left`:i.status==='IN_STOCK'?'In stock':i.status==='MEDIUM_STOCK'?'Medium stock':i.status==='LOW_STOCK'?'Low stock':'Out of stock'}</span></div></div></div>)}</div></section>
  <section className="panel"><div className="section-head"><h2>{t.hours}</h2><Clock3 size={18}/></div><div className="hours-list">{business.hours?.map(h=><div key={h.day}><span>{h.day}</span><b>{h.is_closed?'Closed':`${formatTime(h.open_time)} – ${formatTime(h.close_time)}`}</b></div>)}</div></section>
  <a className="primary call" href={`tel:${business.phone}`}><Phone size={17}/> Call business</a>
</div>}
function ProductSearchListings({query,businesses,openBusiness}){const words=query.toLowerCase().trim().split(/\s+/).filter(Boolean);const listings=businesses.flatMap(b=>(b.items||[]).filter(i=>{const hay=`${i.name} ${i.description||''}`.toLowerCase();return words.every(w=>hay.includes(w))||hay.includes(query.toLowerCase())}).map(i=>({item:i,business:b})));return <section className="panel product-search-results"><div className="section-head"><div><h2>Items matching “{query}”</h2><small>Compare listed prices and shops before visiting</small></div><Package size={18}/></div>{listings.length?listings.map(({item,business})=><button className="product-listing" key={`${business.id}-${item.id}`} onClick={()=>openBusiness(business)}><span className="product-listing-icon"><Package size={18}/></span><span className="product-listing-copy"><b>{item.name}</b><small>{business.name} · {business.address}</small><em>{business.is_open?'Open now':'Currently closed'} · {item.status==='OUT_OF_STOCK'?'Out of stock':item.quantity>0&&item.quantity<5?`Only ${item.quantity} left`:'Check availability with shop'}</em></span><span className="product-listing-price"><strong>{priceText(item)}</strong><small className="market-price-range">{marketPriceText(item)}</small></span><ChevronRight size={16}/></button>):<p className="muted">No exact item listing found for this search in the current local catalog. Try a shorter name or check back as shops add inventory.</p>}</section>}
function BusinessDashboard({api,t,logout}){const [biz,setBiz]=useState(null);const [demand,setDemand]=useState(null);const [tab,setTab]=useState('overview');const [editing,setEditing]=useState(false);const [form,setForm]=useState({});const [hours,setHours]=useState([]);const [closedToday,setClosedToday]=useState(false);const [specialNote,setSpecialNote]=useState('');const [msg,setMsg]=useState('');useEffect(()=>{(async()=>{try{const b=await api('/business/me');setBiz(b);setForm(b);setHours(b.hours||[]);try{const special=await api(`/business/${b.id}/special-hours/today`);setClosedToday(!!special.is_closed);setSpecialNote(special.note||'')}catch{}setDemand(await api('/demand').catch(()=>[]))}catch(e){setMsg(e.message)}})()},[]);if(!biz)return <Loading/>;async function saveBiz(){await api(`/business/${biz.id}`,{method:'PATCH',body:JSON.stringify(form)});setBiz(await api('/business/me'));setEditing(false);setMsg('Business profile updated.')};async function saveHours(){await api(`/business/${biz.id}/hours`,{method:'PUT',body:JSON.stringify({hours})});setBiz(await api('/business/me'));setMsg('Weekly opening hours updated.')};async function saveSpecialHours(){await api(`/business/${biz.id}/special-hours/today`,{method:'PUT',body:JSON.stringify({is_closed:closedToday,note:specialNote})});setBiz(await api('/business/me'));setMsg(closedToday?'Your shop is marked closed for today only.':'Today-only closure removed; your weekly schedule applies again.')};async function saveQuantity(i,value){const quantity=Math.max(0,Number(value)||0);await api(`/items/${i.id}`,{method:'PATCH',body:JSON.stringify({quantity})});setBiz(await api('/business/me'));setMsg(`${i.name} stock updated to ${quantity} item${quantity===1?'':'s'}.`)}
return <div className="stack"><PageTitle title={t.dashboard} icon={<Store/>}/><div className="dashboard-head"><div><span className="eyebrow">SHOP OWNER</span><h1>{biz.name}</h1><p>{biz.profile_completeness}% profile complete</p></div><button className="danger-outline" onClick={logout}><LogOut size={16}/>Logout</button></div><div className="tabs">{[['overview','Overview'],['inventory','Inventory'],['hours','Hours'],['demand','Demand tips']].map(x=><button className={tab===x[0]?'tab active':'tab'} onClick={()=>setTab(x[0])} key={x[0]}>{x[1]}</button>)}</div>{biz.verification_status==='PENDING'&&<div className="notice">Your listing is live. Add your items, prices and opening hours so local customers can find you.</div>}{biz.verification_status==='REJECTED'&&<div className="error-banner">Your listing is currently hidden from customers. Please contact the Market Hub team.</div>}{msg&&<div className="notice">{msg}</div>}
{tab==='overview'&&<><div className="metric-grid"><Metric label="Listing" value={biz.verification_status==='PENDING'?'Pending':biz.verification_status==='REJECTED'?'Hidden':'Live'}/><Metric label="Items" value={biz.items.length}/><Metric label="Status" value={biz.is_open?'Open':'Closed'}/></div><section className="panel"><div className="section-head"><h2>Business profile</h2><button className="icon-btn" onClick={()=>setEditing(!editing)}><Edit3 size={16}/></button></div>{editing?<div className="form-grid">{['name','category','phone','address','description','service_area','max_service_radius','visit_charge','latitude','longitude'].map(k=><label key={k}>{k.replace('_',' ')}<input type={['max_service_radius','visit_charge'].includes(k)?'number':'text'} min={['max_service_radius','visit_charge'].includes(k)?'0':undefined} value={form[k]??''} onChange={e=>setForm({...form,[k]:e.target.value})}/></label>)}{biz.home_visit?<><label className="check-field"><input type="checkbox" checked={!!form.home_visit} onChange={e=>setForm({...form,home_visit:e.target.checked?1:0})}/> Home visit</label><label className="check-field"><input type="checkbox" checked={!!form.emergency_service} onChange={e=>setForm({...form,emergency_service:e.target.checked?1:0})}/> Emergency service</label><label className="check-field"><input type="checkbox" checked={!!form.appointment_required} onChange={e=>setForm({...form,appointment_required:e.target.checked?1:0})}/> Appointment required</label></>:null}<button className="primary" onClick={saveBiz}><Save size={16}/>Save changes</button></div>:<p>{biz.description||'Add a description to improve your listing.'}</p>}</section></>}
{tab==='inventory'&&<section className="panel"><div className="section-head"><div><h2>Inventory</h2><small>Enter the exact quantity. Customers only see the exact number when fewer than 5 remain.</small></div><AddItem api={api} businessId={biz.id} refresh={async()=>setBiz(await api('/business/me'))}/></div>{biz.items.map(i=><div className="inventory-row" key={i.id}><div><b>{i.name}</b><small>{priceText(i)} · Updated {relative(i.updated_at)}</small><small className="market-price-range">{marketPriceText(i)}</small></div><div className="inventory-controls"><label><span>Items</span><input type="number" min="0" value={i.quantity??0} onChange={e=>setBiz({...biz,items:biz.items.map(x=>x.id===i.id?{...x,quantity:e.target.value}:x)})} onBlur={e=>saveQuantity(i,e.target.value)}/></label><span className={`stock-button ${i.status.toLowerCase()}`}>{i.status==='IN_STOCK'?'HIGH STOCK':i.status==='MEDIUM_STOCK'?'MEDIUM STOCK':i.status==='LOW_STOCK'?'LOW STOCK':'OUT OF STOCK'}</span></div></div>)}</section>}
{tab==='hours'&&<><section className="panel special-hours-panel"><div className="section-head"><div><h2>One-time change for today</h2><small>This does not change your regular weekly schedule.</small></div><CalendarClock size={20}/></div><label className="check-field closed-today-toggle"><input type="checkbox" checked={closedToday} onChange={e=>setClosedToday(e.target.checked)}/><span><b>Closed today</b><small>Mark your shop closed for today only. Your normal hours resume tomorrow.</small></span></label><label className="special-note-label">Optional note for customers<input value={specialNote} onChange={e=>setSpecialNote(e.target.value)} maxLength={160} placeholder="e.g. Personal work — reopening tomorrow"/></label><button className="primary" onClick={saveSpecialHours}><Save size={16}/>{closedToday?'Save today’s closure':'Apply today’s hours'}</button></section><section className="panel"><div className="section-head"><h2>Weekly hours</h2><button className="primary small" onClick={saveHours}><Save size={15}/>Save</button></div>{hours.map((h,idx)=><div className="hour-editor" key={h.day}><b>{h.day}</b><label className="switch"><input type="checkbox" checked={!h.is_closed} onChange={e=>setHours(hours.map((x,i)=>i===idx?{...x,is_closed:!e.target.checked}:x))}/><span/></label>{!h.is_closed&&<><input type="time" value={h.open_time||''} onChange={e=>setHours(hours.map((x,i)=>i===idx?{...x,open_time:e.target.value}:x))}/><span>to</span><input type="time" value={h.close_time||''} onChange={e=>setHours(hours.map((x,i)=>i===idx?{...x,close_time:e.target.value}:x))}/></>}</div>)}</section></>}
{tab==='demand'&&<section className="panel"><div className="section-head"><div><h2>Demand tips</h2><small>Sample tips curated by the Market Hub team on what local customers may want.</small></div><BarChart3/></div>{demand?.length?demand.map(x=><div className="demand-row" key={x.id}><div><b>{x.item}</b><small>{x.action}</small></div><strong>{x.increase}</strong></div>):<Empty text="No tips right now."/>}</section>}
</div>}
function AdminDashboard({api,logout}){const [data,setData]=useState(null);const [shops,setShops]=useState([]);const [tab,setTab]=useState('registrations');const [msg,setMsg]=useState('');
  async function load(){try{setData(await api('/admin/overview'));setShops(await api('/admin/businesses'))}catch(e){setMsg(e.message)}}
  useEffect(()=>{load()},[]);
  async function setStatus(id,status){try{await api(`/admin/businesses/${id}/status`,{method:'PATCH',body:JSON.stringify({status})});await load()}catch(e){setMsg(e.message)}}
  if(!data)return msg?<div className="error-banner">{msg}</div>:<Loading/>;
  const label=s=>s==='PENDING'?'Waiting for approval':s==='REJECTED'?'Hidden':s==='VERIFIED'?'Live · verified':'Live';
  return <div className="stack"><PageTitle title="Admin" icon={<ShieldCheck/>}/><div className="dashboard-head"><div><span className="eyebrow">MARKET HUB ADMIN</span><h1>Registrations & photos</h1></div><button className="danger-outline" onClick={logout}><LogOut size={16}/>Logout</button></div>
  <div className="metric-grid"><Metric label="Live shops" value={data.liveBusinesses}/><Metric label="Hidden / pending" value={data.pendingRegistrations}/><Metric label="Photos" value={data.photos}/></div>
  {msg&&<div className="notice">{msg}</div>}
  <div className="tabs">{[['registrations','Business listings'],['photos','Shop photos']].map(x=><button className={tab===x[0]?'tab active':'tab'} onClick={()=>setTab(x[0])} key={x[0]}>{x[1]}</button>)}</div>
  {tab==='registrations'&&<section className="panel"><h2>Shops</h2>{shops.length?shops.map(s=><div className="admin-row" key={s.id}><div><b>{s.name}</b><small>{s.category} · {s.phone||'no phone'} · {label(s.verification_status)}{s.owner_email?` · ${s.owner_email}`:''}</small></div><div className="inline-form">{s.verification_status!=='VERIFIED'&&s.verification_status!=='UNCLAIMED'&&<button className="primary small" onClick={()=>setStatus(s.id,'VERIFIED')}>Approve</button>}{s.verification_status==='PENDING'&&<button className="secondary small" onClick={()=>setStatus(s.id,'REJECTED')}>Reject</button>}{(s.verification_status==='VERIFIED'||s.verification_status==='UNCLAIMED')&&<button className="secondary small" onClick={()=>{if(confirm(`Hide ${s.name} from customers?`))setStatus(s.id,'REJECTED')}}>Hide</button>}</div></div>):<Empty text="No shops yet."/>}</section>}
  {tab==='photos'&&<AdminPhotos api={api} shops={shops}/>}
  </div>}
function AdminPhotos({api,shops}){
  const [shopId,setShopId]=useState(''),[photos,setPhotos]=useState([]),[preview,setPreview]=useState(''),[caption,setCaption]=useState(''),[busy,setBusy]=useState(false),[msg,setMsg]=useState('');
  const inputRef=useRef(null);
  async function loadPhotos(id){setPhotos(id?await api(`/businesses/${id}/photos`):[])}
  useEffect(()=>{loadPhotos(shopId).catch(e=>setMsg(e.message))},[shopId]);
  async function choose(e){const f=e.target.files?.[0];if(!f)return;setMsg('');if(!['image/jpeg','image/png','image/webp'].includes(f.type)){setMsg('Please choose a JPG, PNG or WebP image.');return}if(f.size>12*1024*1024){setMsg('Please choose an image smaller than 12 MB.');return}try{setPreview(await compressImage(f))}catch{setMsg('Could not read this image. Please try another photo.')}}
  async function upload(){if(!preview||!shopId)return;setBusy(true);setMsg('');try{await api(`/businesses/${shopId}/photos`,{method:'POST',body:JSON.stringify({image_data:preview,caption})});setPreview('');setCaption('');if(inputRef.current)inputRef.current.value='';setMsg('Photo uploaded.');await loadPhotos(shopId)}catch(e){setMsg(e.message)}finally{setBusy(false)}}
  async function remove(id){if(!confirm('Remove this shop photo?'))return;try{await api(`/business-photos/${id}`,{method:'DELETE'});await loadPhotos(shopId)}catch(e){setMsg(e.message)}}
  return <section className="panel photo-panel">
    <div className="section-head"><div><h2><Camera size={18}/> Shop photos</h2><small>Only the admin can add or remove shop photos.</small></div></div>
    <label className="special-note-label">Shop<select value={shopId} onChange={e=>{setShopId(e.target.value);setMsg('')}}><option value="">Choose a shop…</option>{shops.map(s=><option key={s.id} value={s.id}>{s.name}</option>)}</select></label>
    {msg&&<div className="notice">{msg}</div>}
    {shopId&&<div className="photo-uploader">
      <input ref={inputRef} className="photo-file-input" type="file" accept="image/jpeg,image/png,image/webp" onChange={choose}/>
      <div className={preview?'photo-preview has-image':'photo-preview'}>{preview?<img src={preview} alt="Selected shop"/>:<><Camera size={30}/><b>Select a shop photo</b><small>JPG, PNG or WebP</small></>}</div>
      <div className="inline-form photo-actions"><button type="button" className="secondary small" onClick={()=>inputRef.current?.click()}><Camera size={15}/>{preview?'Change photo':'Choose photo'}</button><button type="button" className="primary small" disabled={!preview||busy} onClick={upload}>{busy?'Uploading…':'Upload photo'}</button></div>
      <input className="caption-input" placeholder="Caption (optional)" value={caption} onChange={e=>setCaption(e.target.value)} maxLength={180}/>
    </div>}
    {shopId&&(photos.length?<div className="photo-grid">{photos.map(p=><figure className="shop-photo" key={p.id}><img src={p.image_url} alt={p.caption||'Shop photo'}/><figcaption>{p.caption&&<p>{p.caption}</p>}<button className="photo-remove" onClick={()=>remove(p.id)} title="Remove photo"><X size={14}/></button></figcaption></figure>)}</div>:<Empty text="No photos for this shop yet."/>)}
