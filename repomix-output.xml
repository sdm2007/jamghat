      <div className="top-actions"><button className="icon-btn" title="Language" onClick={()=>setLang(x=>x==='en'?'hi':'en')}>{lang==='en'?'हिन्दी':'EN'}</button><ThemeButton theme={theme} setTheme={setTheme}/>{user?<><button className="primary small" onClick={()=>setPage(homeOfUser)}>{user.role==='ADMIN'?'Admin':'My shop'}</button><button className="icon-btn" title="Log out" onClick={logout}><LogOut size={16}/></button></>:<button className="secondary small" onClick={()=>setAuthMode('login')}>{t.login}</button>}</div>
