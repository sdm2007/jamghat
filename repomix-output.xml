  ['ALL','All / सब','🏪'],['Books & Stationery','Books','📚'],['Grocery','Grocery','🛒'],['Beauty & Barber','Salon','✂️'],
  ['Tailor','Tailor','🧵'],['Mobile Repair','Mobile','📱'],['Bakery','Bakery','🥐'],['Hardware','Hardware','🔧'],['Home Services','Services','🏠'],['Agriculture & Tools','Kisan','🚜']
