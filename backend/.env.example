# Supabase > Project Settings > Database > Connection string (URI). Use the pooler URI for hosted deployments.
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_DATABASE_PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres
PGSSLMODE=require
PG_POOL_MAX=5
NODE_ENV=production
PORT=5000
# Create your one administrator account on first startup. Use a unique password (12+ characters).
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=replace-with-a-long-unique-password
# Required only if the frontend is hosted separately. Use exact origins, comma-separated.
# CORS_ORIGIN=https://your-frontend.example.com
# Supabase Storage: copy your project URL and server-side secret/service_role key from Supabase API settings.
# Keep this key ONLY in backend environment variables; never use a VITE_ variable for it.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_STORAGE_BUCKET=business-photos

# Email verification for business-owner registration (SMTP credentials from your email provider).
# Use your provider's SMTP details; do not use a Supabase database password here.
SMTP_HOST=smtp.your-provider.example
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
EMAIL_FROM="Market Hub <verified-sender@example.com>"
# URL included in the verification email; use http://localhost:5000 locally and your HTTPS domain in production.
PUBLIC_APP_URL=http://localhost:5000
